# This file contains the API key for TMDB API. It is used to authenticate the requests to the API. The API key is stored in an environment variable for security reasons.

TMDB_API_KEY=
FLASK_SECRET_KEY=
# Mot de passe unique protégeant tout le site (page /login).
SITE_PASSWORD=
# Backup pulled by the PC (hourly cron, shared script outside this repo) into backups/
BACKUP_SSH_HOST=   # ~/.ssh/config alias of the hosting account (key auth)
BACKUP_REMOTE_DB=  # absolute path of the production database on the server
# BACKUP_DIR=backups  BACKUP_KEEP=10  (optional)

# Deployment by deploy-alwaysdata.sh
DEPLOY_SSH_HOST=    # ~/.ssh/config alias of the hosting account (key auth)
DEPLOY_REMOTE_DIR=  # app directory on the server, e.g. /home/<account>/www/movies
